# ==========================================
# SwiftCart Backend Environment Variables
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/swiftcart
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/swiftcart?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRE=7d

# Stripe Configuration (Get these from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Client Configuration
CLIENT_URL=http://localhost:5173
# For production:
# CLIENT_URL=https://yourdomain.com

# Email Configuration (Optional - for future email features)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-email-password

# File Upload Configuration (Optional - for future file upload features)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting Configuration (Optional - defaults provided)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration (Optional - defaults provided)
# SESSION_SECRET=your_session_secret_here

# ==========================================
# Security Notes:
# ==========================================
# 1. Never commit this file to version control
# 2. Use strong, unique secrets for production
# 3. Regularly rotate your secrets
# 4. Use environment-specific configurations
# 5. Consider using a secret management service for production
# ==========================================